# Mira V1 Foundation - Environment Configuration Example
# Copy to .env for local configuration

# Application Environment (development, test, production)
APP_ENV=development

# Public demo account selection is server controlled and disabled in production.
MIRA_DEMO_MODE=true

# Core API Server Port
PORT=4000

# PostgreSQL Connection URL
# For native development:
DATABASE_URL=postgres://postgres@127.0.0.1:5433/mira_dev
# For Docker Compose:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/mira_dev

# Cryptographic Secret for JWT Session Tokens (Minimum 32 characters)
JWT_SECRET=mira-v1-foundation-secure-jwt-secret-key-minimum-32-chars

# Token Expiration Duration in Hours
JWT_EXPIRATION_HOURS=24

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Groq chat completion credentials (server-side only; never use a VITE_/NEXT_PUBLIC_ prefix)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Logging Level (error, warn, info, debug, trace)
RUST_LOG=mira_api=debug,tower_http=info

